{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naruto-shinobi-legacy-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naruto-shinobi-legacy",
      "database_id": "e647d32a-08b7-4b57-a814-4c96019c5b68"
    }
  ]
}
